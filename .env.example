# Configuration for the optional live-Moodle overlay (docker-compose.moodle.yml).
# Copy this file to ".env" -- the defaults below work as-is once you have placed
# moodle-src.tar.gz in docker/moodle-dist/ (see DOCKER_DEMO.md, Step A).
#
# The base PM4Moodle demo (docker-compose.yml) does NOT need this file at all.

# --- Moodle login (used by the live-Moodle overlay) -------------------------
# The test dataset's original admin password is not published, so the password
# below is applied to the 'admin' account when the container starts.
# LOCAL DEMO ONLY - this instance holds test data and is not exposed publicly.
# Moodle requires 8+ characters with upper case, lower case, a digit and a symbol.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Pm4Moodle!Demo1

# --- Maintainers only: rebuild the Moodle archive --------------------------
# Not needed for testing -- leave commented out if you downloaded the prepared
# archive. Only set MOODLE_SRC if you want to regenerate moodle-src.tar.gz from
# your own Moodle install: point it at the folder containing version.php,
# config.php, admin/, course/, mod/ and then run docker/prepare-moodle.ps1
# (Windows) or docker/prepare-moodle.sh (macOS/Linux).

# Windows (forward slashes work too):
# MOODLE_SRC=C:/MoodleWindowsInstaller-latest/server/moodle
# macOS / Linux:
# MOODLE_SRC=/Users/you/moodle

# --- Optional: uploaded files ----------------------------------------------
# Point this at a moodledata folder (the one containing filedir/) to make
# previously-uploaded files appear in Moodle. Mounted read-only. Leave it unset
# to start with empty file storage — everything else still works.

# MOODLE_DATA_SRC=C:/MoodleWindowsInstaller-latest/server/moodledata
# MOODLE_DATA_SRC=/Users/you/moodledata
