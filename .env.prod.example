# Configuration for the server deployment (docker-compose.prod.yml).
#
#   cp .env.prod.example .env.prod
#
# Then replace every CHANGE_ME below. None of these values may stay at a
# default: the site is reachable from the internet.

# --- Public address ---------------------------------------------------------
# The scheme and host the testers use, with NO trailing slash and no path.
# Moodle's wwwroot is derived from it as ${PUBLIC_BASE_URL}/moodle.
PUBLIC_BASE_URL=https://pm4moodle.dsv.su.se

# Port on the Docker host that the outer reverse proxy forwards to.
PUBLIC_PORT=8080

# --- Database ---------------------------------------------------------------
# Not reachable from outside the Docker network, but both applications use
# these, so they still need to be real secrets.
DB_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- Moodle administrator ---------------------------------------------------
# Applied to the 'admin' account every time the container starts. The dataset's
# own admin password is unknown, so this is the only way in.
# Moodle requires 8+ characters with upper case, lower case, a digit and a symbol.
# Do NOT reuse Pm4Moodle!Demo1 from .env.example — it is public in the repository.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME
